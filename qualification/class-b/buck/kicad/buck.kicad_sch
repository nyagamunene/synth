	(text
		"MECHANICAL"
		(at 348.9391 15.81 0)
		(effects
			(font
				(size 2.54 2.54)
				bold
			)
			(justify left bottom)
		)
		(uuid "bf359efe-451f-5491-ab50-ca28b08566c6")
