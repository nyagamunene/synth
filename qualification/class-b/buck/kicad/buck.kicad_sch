	(text
		""
		(at 17.28 46.88 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "49440ab3-5e44-5a53-8510-c9cd7c608393")
	)
	(text
		"J1 pin 1 is +24 V, pin 2 is GND."
		(at 17.28 50.88 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "36dc3697-f160-5657-9ee0-08802d56734b")
	)
	(text
		"F1 resettable PTC: Ihold 1.1 A, Vmax 33 V."
		(at 17.28 53.42 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "52136f32-4550-513f-8f5b-ce2760da10f3")
	)
	(text
		"D1 Schottky in series blocks reverse polarity."
		(at 17.28 55.96 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4ba61855-8b55-58f3-883e-4b1248a9ea11")
	)
	(text
		"D2 TVS (30 V standoff) sits after D1, directly on the VIN node. Its 48.4 V clamp is below U1's 85 V absolute maximum, so U1 stays within its rating under a surge the TVS can absorb."
		(at 17.28 58.5 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "b0775773-63f1-5e38-a56b-9eda3abb3575")
	)
	(text
		""
		(at 18.55 118 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "7c897688-bb42-5f34-a43b-51ec1878dec2")
	)
	(text
		"C1 bulk, C2 ceramic, C3 high-frequency next to the VIN pin (LMR38010 section 9.2.2.6: at least 4.7 uF + 100 to 220 nF)."
		(at 18.55 122 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "3a794fef-3106-5060-b744-258731dba5bb")
	)
	(text
		"50 V parts for a 24 V rail; DC-bias derating of C2 is not known."
		(at 18.55 124.54 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "033c229a-975e-534f-a19e-697ae802cdfd")
	)
	(text
		""
		(at 148.16 118 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "67d09a96-3729-5a21-a544-facb3b94c530")
	)
	(text
		"EN divider from VIN. LMR38010 VEN-H 1.25 V typical (1.1 to 1.4), VEN-L 1.10 V typical: start 18.4 V (16.2 to 20.6 V), stop 16.2 V."
		(at 148.16 122 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "409ac241-5cf0-5fed-a33d-714ac6fad98d")
	)
	(text
		"EN stays under 2 V at a 28 V input (EN absolute maximum is VIN + 0.3 V)."
		(at 148.16 124.54 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "4668f52c-a8b3-5a2b-b456-cfe4776d01d2")
	)
	(text
		""
		(at 18.48 200.55 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "69e2ba63-8a95-5624-a567-166f7aa1e5aa")
	)
	(text
		"LMR38010SDDAR: internal compensation, exposed pad (pin 9) on GND, open-drain PG, PFM with spread spectrum."
		(at 18.48 204.55 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "066de488-ce52-5a2b-85cb-ec68c1199551")
	)
	(text
		"R_RT 33k from RT/SYNC to GND sets 800 kHz (RT table under datasheet Figure 8-4); the pin must not float."
		(at 18.48 207.09 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "bda8cde3-83e3-5d00-b32c-44e0024958d6")
	)
	(text
		"C4 100 nF boot capacitor between BOOT and SW."
		(at 18.48 209.63 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "a266536b-8326-531f-8d4c-697c3e357cbf")
	)
	(text
		"L1 6.8 uH at 800 kHz gives about 0.5 A ripple at 26.4 V in (datasheet Eq 10 K about 0.5), above the 1.03 uH minimum of Eq 11 (0.25 x 3.3 V / 800 kHz); 3x 22 uF is unverified: Table 9-1 has no 3.3 V row."
		(at 18.48 212.17 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "496dc412-2c4d-53cb-abaa-f5c2d94ddc64")
	)
	(text
		"The exposed pad (pin 9) is soldered to the F.Cu GND pour. There are no vias in the pad:"
		(at 18.48 214.71 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "1238fc91-3eed-5cfc-a95e-dd163f77b680")
	)
	(text
		"the board's fabrication floor is a 0.3 mm drill and the KiCad thermal-via footprint ships 0.2 mm."
		(at 18.48 217.25 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "a1857f14-f073-5446-a30a-7e39fe205bd3")
	)
	(text
		""
		(at 208.17 44.34 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "1f0c795b-396e-549e-bb3e-16ce8dbc9055")
	)
	(text
		"Vout = 1.0 V x (1 + 100k / 43.2k) = 3.31 V."
		(at 208.17 48.34 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "290e28a8-bae6-54e9-8ca8-36d16ca6678c")
	)
	(text
		"Divider taps the output node on the far side of L1, not SW."
		(at 208.17 50.88 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "cf9fd1c4-df08-515a-87a3-cf4f53eba26d")
	)
	(text
		"C7 56 pF feed-forward across the upper resistor (datasheet Eq 9 gives about 60 pF)."
		(at 208.17 53.42 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "de1db3bc-a810-5e84-b69b-68d8a1c4b644")
	)
	(text
		""
		(at 290.43 128.16 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "6c68fb9e-37bb-5ac2-b4fe-90b7d5df0171")
	)
	(text
		"PG is open drain and pulled up to +3V3 through 100k (datasheet 8.3.5: pull up through a resistor; PG tolerates 20 V)."
		(at 290.43 132.16 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "02618b54-4eed-57a5-9f2a-eb1421e1d3e5")
	)
	(text
		"PG goes low during start-up and on a fault, so J2 pin 3 reads valid only after the 4 ms start-up delay."
		(at 290.43 134.7 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "cda9a13d-cf76-5431-a467-1e8630cabc67")
	)
	(text
		"D4 green fault LED from +3V3 through R_PGLED to PG: it is lit while PG is low, dark while power is good."
		(at 290.43 137.24 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "edac6f00-4e72-5a9b-a5a6-83379822f821")
	)
	(text
		"About 2.5 mA when lit (470 R, Vf about 2.1 V); U1's PG pull-down is about 92 ohm RDSON, so PG stays near 0.4 V."
		(at 290.43 139.78 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "cfaa4505-bdde-5ba4-82e4-ae76b78e9ac9")
	)
	(text
		""
		(at 289.3 219.6 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a488ab96-1f69-5dee-891f-51ecd755994b")
	)
	(text
		"J2 pin 1 is +3.3 V, pin 2 GND, pin 3 power-good (3.3 V logic, 100k pull-up), pin 4 GND."
		(at 289.3 223.6 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "1df6ed53-5e99-507b-9ceb-501667fdd7f6")
	)
	(text
		"D3 green power LED from the 3.3 V rail."
		(at 289.3 226.14 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "7a80aa5d-e641-5ccd-b223-3107cd032932")
	)
	(text
		""
		(at 319.96 43.07 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "1f40392e-bd6f-5072-a961-56826b7a6812")
	)
	(text
		"Two M2.5 non-plated holes in opposite corners; the board is fixed down through them."
		(at 319.96 47.07 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left bottom)
		)
		(uuid "1c5f1e65-c7e5-58eb-a501-4466ab8efb4f")
	)
